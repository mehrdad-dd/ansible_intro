# Install mkpasswd if not available
apt-get install whois  # Debian/Ubuntu
# OR
yum install expect      # RHEL/CentOS

# Generate password hash (use a strong password!)
mkpasswd --method=sha-512 --rounds=656000 'YourSecurePassword123!'

# Or use Python
python3 -c "import crypt; print(crypt.crypt('YourSecurePassword123!', crypt.mksalt(crypt.METHOD_SHA512)))"
