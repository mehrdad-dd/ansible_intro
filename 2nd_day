
  # =========================================================================
  # HANDLERS SECTION
  # =========================================================================
  # Handlers run only when notified by tasks, and only once at the end of play
  handlers:
    - name: validate configuration
      # Handler to check application config syntax
      ansible.builtin.command: "echo 'Configuration validated at {{ ansible_date_time.time }}'"
      changed_when: false
      listen: "app_config_changed"  # Can be triggered by name or listen

    - name: reload nginx
      # Gracefully reload Nginx without dropping connections
      ansible.builtin.service:
        name: nginx
        state: reloaded
      # Only reload if syntax test passed
      when: 
        - nginx_test is defined
        - nginx_test.rc == 0
      listen: "nginx_config_changed"

    - name: restart application
      ansible.builtin.systemd:
        name: "{{ app_name }}"
        state: restarted
        daemon_reload: yes
      listen: "app_restart_needed"
